# ==============================================================================
# GridSense Delhi - Environment Variables Configuration
# ==============================================================================

# Database Connection (Default: Canonical SQLite database file in backend/)
DATABASE_URL=sqlite:///./gridsense.db

# Security & Session Secret
SECRET_KEY=gridsense-delhi-secret-super-secure-key-2026-sldc-discoms
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Allowed CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000","*"]

# Polling Frequencies (Seconds)
SLDC_POLL_INTERVAL_SECONDS=180
WEATHER_POLL_INTERVAL_SECONDS=1800
FORECAST_INTERVAL_SECONDS=3600

# Discom Licensed Peak Capacities (MW)
DELHI_PEAK_CAPACITY_MW=9000.0
BRPL_PEAK_CAPACITY_MW=3800.0
BYPL_PEAK_CAPACITY_MW=2000.0
TPDDL_PEAK_CAPACITY_MW=2500.0
NDMC_PEAK_CAPACITY_MW=450.0
MES_PEAK_CAPACITY_MW=75.0

# Delhi Solar Policy 2024 Targets (MW)
DEFAULT_SOLAR_INSTALLED_CAPACITY_MW=1500.0
